{
  "name": "hygen",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine"
  ],
  "scripts": {
    "build": "node engine/src/cli.ts build",
    "doctor": "node engine/src/cli.ts doctor",
    "verify": "node engine/src/cli.ts verify",
    "scene": "node engine/src/cli.ts scene",
    "scenes": "node engine/src/cli.ts scenes",
    "typecheck": "npm --workspace engine run typecheck",
    "voices": "node engine/src/voices.ts",
    "media": "node engine/src/media.ts",
    "publish": "node engine/src/cli.ts publish",
    "voice": "node engine/src/voice-cli.ts",
    "migrate": "node engine/src/migrate.ts",
    "library:previews": "node engine/src/library-previews.ts",
    "studio": "node studio/server.ts",
    "studio:check": "node studio/check.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "chokidar": "4.0.3",
    "node-pty": "1.1.0",
    "ws": "8.18.3"
  }
}
