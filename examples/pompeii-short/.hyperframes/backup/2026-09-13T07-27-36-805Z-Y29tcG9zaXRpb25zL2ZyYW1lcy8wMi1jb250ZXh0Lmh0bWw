<script>
  (function () {
    var D = 8.291;
    var byId = function (id) {
      return document.getElementById(id);
    };
    var tl = gsap.timeline({ paused: true });

    // ── setup: measure every drawn stroke once (getTotalLength), hide it behind its own dash gap ──
    function prepDraw(el, fallback) {
      var len = el.getTotalLength ? el.getTotalLength() : 0;
      if (!(len > 1)) len = fallback;
      len = Math.ceil(len) + 2;
      el.style.strokeDasharray = len + " " + (len + 24);
      el.style.strokeDashoffset = String(len);
      return len;
    }
    var coast = byId("f02-context-coast");
    var routeReveal = byId("f02-context-route-reveal");
    var ruleL = byId("f02-context-rule-l");
    var ruleR = byId("f02-context-rule-r");
    var leader = byId("f02-context-leader");
    var coastLen = prepDraw(coast, 1239);
    var routeLen = prepDraw(routeReveal, 145);
    var ruleLen = prepDraw(ruleL, 450);
    prepDraw(ruleR, 450);
    var leaderLen = prepDraw(leader, 146);

    // thin-space thousands separator, locale-independent
    function fmt(n) {
      var s = String(n);
      return s.length > 3 ? s.slice(0, s.length - 3) + " " + s.slice(s.length - 3) : s;
    }

    // ── multi-phase camera: pull-back 0.965 → focus 1.0 (lands 2.0s) → slow push 1.025 on «Вулкан» ──
    // Phase scale and sine drift are both pure functions of timeline time, composed in ONE writer,
    // so any seek order produces the same transform.
    var camera = byId("f02-context-camera");
    var easeFocus = gsap.parseEase("power2.out");
    var easePush = gsap.parseEase("power2.inOut");
    var PHASE_1_SCALE = 0.965;
    var PHASE_2_SCALE = 1;
    var PHASE_3_SCALE = 1.025;
    var PHASE_2_AT = 0.15;
    var PHASE_2_DUR = 1.85;
    var PHASE_3_AT = 6.13;
    var PHASE_3_DUR = D - 6.13;
    var DRIFT_CYCLES = 1;
    var DRIFT_AMP_X = 4;
    var DRIFT_AMP_Y = 2;
    var DRIFT_FREQ_RATIO = 1.3;
    function phaseScale(t) {
      if (t <= PHASE_2_AT) return PHASE_1_SCALE;
      if (t < PHASE_2_AT + PHASE_2_DUR) return PHASE_1_SCALE + (PHASE_2_SCALE - PHASE_1_SCALE) * easeFocus((t - PHASE_2_AT) / PHASE_2_DUR);
      if (t <= PHASE_3_AT) return PHASE_2_SCALE;
      if (t < PHASE_3_AT + PHASE_3_DUR) return PHASE_2_SCALE + (PHASE_3_SCALE - PHASE_2_SCALE) * easePush((t - PHASE_3_AT) / PHASE_3_DUR);
      return PHASE_3_SCALE;
    }
    function writeCamera(t) {
      var p = (Math.PI * 2 * DRIFT_CYCLES * t) / D;
      var dx = Math.sin(p) * DRIFT_AMP_X;
      var dy = Math.sin(p * DRIFT_FREQ_RATIO) * DRIFT_AMP_Y;
      camera.style.transform = "scale(" + phaseScale(t).toFixed(5) + ") translate(" + dx.toFixed(3) + "px, " + dy.toFixed(3) + "px)";
    }
    // The ember ring (spreads once on «Помпеи») and the 0 → 11 000 count are written by the same
    // full-span driver: a seek that lands past a finished segment still writes its final state.
    var ring = byId("f02-context-ring");
    var countEl = byId("f02-context-count");
    var easeCount = gsap.parseEase("power2.out");
    var RING_AT = 0.2;
    var RING_DUR = 0.9;
    var COUNT_AT = 2.12;
    var COUNT_DUR = 1.1;
    var COUNT_TO = 11000;
    var shownCount = "";
    // one ember ring: r 12 → 60, opacity 0.8 → 0
    function writeRing(t) {
      var p = (t - RING_AT) / RING_DUR;
      if (p <= 0 || p >= 1) {
        ring.setAttribute("opacity", "0");
        return;
      }
      ring.setAttribute("r", (12 + 48 * (1 - (1 - p) * (1 - p))).toFixed(2));
      ring.setAttribute("opacity", (0.8 * (1 - p * p)).toFixed(3));
    }
    // 0 → 11 000 lands on «тысяч»
    function writeCount(t) {
      var p = Math.min(1, Math.max(0, (t - COUNT_AT) / COUNT_DUR));
      var text = fmt(Math.round(COUNT_TO * easeCount(p)));
      if (text !== shownCount) {
        countEl.textContent = text;
        shownCount = text;
      }
    }
    function writeDriven(t) {
      writeCamera(t);
      writeRing(t);
      writeCount(t);
    }
    var drive = { t: 0 };
    writeDriven(0);
    tl.fromTo(drive, { t: 0 }, { t: D, duration: D, ease: "none", onUpdate: function () { writeDriven(drive.t); } }, 0);

    // ── Scene 1 (0.00–1.40): coastline draws Naples → Sorrento, sea settles under it, Pompeii marked ──
    tl.fromTo(coast, { strokeDashoffset: coastLen }, { strokeDashoffset: 0, duration: 1.1, ease: "power2.inOut" }, 0);
    tl.fromTo(byId("f02-context-sea"), { opacity: 0 }, { opacity: 1, duration: 1.15, ease: "power1.inOut" }, 0.05);
    // «Помпеи» 0.20 — ember dot pops in place, no overshoot
    tl.fromTo(
      byId("f02-context-dot"),
      { opacity: 0, scale: 0.6, svgOrigin: "682 554" },
      { opacity: 1, scale: 1, svgOrigin: "682 554", duration: 0.5, ease: "power3.out" },
      0.2
    );
    // (the ember ring is written by the driver above)
    // «ПОМПЕИ» — mask reveal left → right
    tl.fromTo(
      byId("f02-context-pompeii"),
      { clipPath: "inset(-30% 100% -30% 0%)" },
      { clipPath: "inset(-30% 0% -30% 0%)", duration: 0.5, ease: "power2.out" },
      0.2
    );
    // bay label settles from 0.9s
    tl.fromTo(byId("f02-context-bay"), { opacity: 0 }, { opacity: 1, duration: 0.6, ease: "power1.out" }, 0.9);

    // ── Scene 2 (0.97–1.90): «портовый» — dashed sea route from the city into the bay ──
    tl.fromTo(routeReveal, { strokeDashoffset: routeLen }, { strokeDashoffset: 0, duration: 0.65, ease: "power2.out" }, 0.97);
    tl.fromTo(
      byId("f02-context-anchor"),
      { opacity: 0, scale: 0.4, svgOrigin: "548 600" },
      { opacity: 1, scale: 1, svgOrigin: "548 600", duration: 0.35, ease: "power3.out" },
      1.42
    );

    // ── Scene 3 (2.12–3.60): «Около» — hairline draws centre-out, ≈ fades, 0 → 11 000 lands on «тысяч» ──
    tl.fromTo([ruleL, ruleR], { strokeDashoffset: ruleLen }, { strokeDashoffset: 0, duration: 0.4, ease: "power2.out" }, 2.12);
    tl.fromTo(byId("f02-context-approx"), { opacity: 0 }, { opacity: 1, duration: 0.5, ease: "power1.out" }, 2.12);
    tl.fromTo(byId("f02-context-count-box"), { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power1.out" }, 2.12);
    // (the 0 → 11 000 text is written by the driver; the scale is a plain tween)
    tl.fromTo(countEl, { scale: 0.6 }, { scale: 1, duration: 1.1, ease: "power2.out" }, 2.12);
    // «жителей» 3.29 — label rises
    tl.fromTo(byId("f02-context-residents"), { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.4, ease: "power2.out" }, 3.29);

    // ── Scene 4 (4.03–5.60): three words, each exactly on its word; separator arrives with the next word ──
    tl.fromTo(byId("f02-context-w1"), { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35, ease: "power3.out" }, 4.03);
    tl.fromTo([byId("f02-context-s1"), byId("f02-context-w2")], { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35, ease: "power3.out" }, 4.5);
    tl.fromTo([byId("f02-context-s2"), byId("f02-context-w3")], { opacity: 0, y: 12 }, { opacity: 1, y: 0, duration: 0.35, ease: "power3.out" }, 5.21);

    // ── Scene 5 (6.13–8.291): «Вулкан» — cone grows out of the land (clipped at its base line) ──
    tl.fromTo(byId("f02-context-cone"), { y: 160 }, { y: 0, duration: 0.9, ease: "power3.out" }, 6.13);
    // «рядом» 6.49 — leader draws from the crater shoulder to the label, label wipes on as it lands
    tl.fromTo(leader, { strokeDashoffset: leaderLen }, { strokeDashoffset: 0, duration: 0.4, ease: "power2.out" }, 6.49);
    tl.fromTo(
      byId("f02-context-vesuvius"),
      { clipPath: "inset(-30% 100% -30% 0%)" },
      { clipPath: "inset(-30% 0% -30% 0%)", duration: 0.4, ease: "power2.out" },
      6.78
