# Зависимости и сборка
node_modules/
dist/

# Рендеры, снимки, кэши (контактные листы роликов коммитим — приёмка по кадрам)
**/renders/*
!videos/*/renders/
!videos/*/renders/*.contact.jpg
!videos/*/renders/blind/
!videos/*/renders/blind/*.contact.jpg
!videos/_proof/*/renders/
!videos/_proof/*/renders/*.contact.jpg
snapshots/
.thumbnails/
.waveform-cache/

# Секреты
.env
.env.*
!.env.example

# Локальные настройки Claude Code
.claude/settings.local.json

# CLAUDE.md коммитим: глобальный ~/.config/git/ignore исключает его во всех репозиториях, здесь возвращаем
!CLAUDE.md

# Кэши Python и бэкапы Studio
__pycache__/
**/.hyperframes/backup/

# Сборка роликов и кэши движка
videos/*/build/
videos/_proof/*/build/
videos/_proof/_*/
.cache/
# Дубли голоса ElevenLabs роликов — videos/<id>/voice/ (take.wav, alignment.json, meta.json, usage.jsonl) коммитим:
# голос едет вместе с проектом. В .cache/voice — только превью голосов.
.preview/

# Старые версии роликов (history/): video.json, research.md, листы и publish коммитим, MP4 — нет
videos/*/history/**/*.mp4
