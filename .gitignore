# Зависимости и сборка
node_modules/
dist/

# Рендеры, снимки, кэши (контактные листы и publish/ проектов коммитим — приёмка по кадрам)
**/renders/*
!projects/*/renders/
!projects/*/renders/*.contact.jpg
!projects/*/renders/blind/
!projects/*/renders/blind/*.contact.jpg
!projects/*/renders/publish/
snapshots/
.thumbnails/
.waveform-cache/

# Секреты (настройки без секретов — hygen.config.json, в git)
.env
.env.*
!.env.example

# Локальные настройки Claude Code
.claude/settings.local.json

# CLAUDE.md коммитим: глобальный ~/.config/git/ignore исключает его во всех репозиториях, здесь возвращаем
!CLAUDE.md

# Кэши Python и бэкапы Studio
__pycache__/
**/.hyperframes/backup/

# Сборка проектов и кэши движка
projects/*/build/
.cache/
# Дубли голоса ElevenLabs — projects/<id>/voice/ (take.wav, alignment.json, meta.json, usage.jsonl) коммитим:
# голос едет вместе с проектом. В .cache/voice — только превью голосов.
.preview/

# История проектов: снимки project.json и media.json, листы и publish коммитим, MP4 — нет
projects/*/history/**/*.mp4

# Превью библиотеки — пересобираются npm run library:previews (кэш по хэшу файла элемента)
library/previews/**/*.mp4
library/previews/**/*.webm
library/previews/**/*.jpg
